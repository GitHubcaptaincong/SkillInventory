# Copy to .env and set unique passwords. Do not commit .env.
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8088
DB_NAME=skill_platform
DB_USER=skill_app
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
ALLOWED_ORIGINS=http://localhost:8088,http://127.0.0.1:8088

ADMIN_USERNAME=
ADMIN_INITIAL_PASSWORD=
SESSION_TIMEOUT=30m
# true for HTTPS; explicit false for local HTTP.
SESSION_COOKIE_SECURE=false
